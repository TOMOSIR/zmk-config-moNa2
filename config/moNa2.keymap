#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 6>;
            key-positions = <32 31>;
        };

        MB3 {
            bindings = <&mkp MB3>;
            key-positions = <33 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        atmark: atmark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "ATMARK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E     &kp R          &kp T                                                      &kp Y     &kp U  &kp I     &kp O     &kp BACKSPACE
&kp A             &kp S         &kp D     &kp F          &kp G      &trans                  &kp SLASH               &kp H     &kp J  &kp K     &kp L     &lt 2 ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C     &kp V          &kp B      &mt LEFT_SHIFT COMMA    &mt RIGHT_SHIFT PERIOD  &kp N     &kp M  &mkp MB1  &mkp MB2  &mt RIGHT_SHIFT P
&kp LCTRL         &kp LEFT_ALT  &kp LCMD  &lt 1 AT_SIGN  &lt 2 TAB  &lt 3 SPACE             &lt 2 SPACE             &kp RCMD                             &mt RIGHT_SHIFT ESC
            >;

            sensor-bindings = <&inc_dec_kp LC(A) LC(S)>;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp UNDERSCORE                               &trans          &kp UP_ARROW    &trans           &trans     &kp PERCENT
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &kp PLUS    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp MINUS  &trans
&trans           &trans         &trans        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans    &kp MINUS   &trans          &trans          &trans           &kp GRAVE  &kp EQUAL
&trans           &trans         &trans        &trans                &trans                 &trans    &kp DELETE  &trans                                                      &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                            &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERIOD    &kp BACKSPACE
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))    &kp PLUS   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &kp EQUAL
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                  &kp MINUS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &kp LEFT
&trans                      &trans           &trans           &trans           &trans        &trans                     &trans     &kp NUMBER_0                                            &kp RIGHT_ARROW
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp LC(GRAVE)   &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)     &kp LG(O)                                   &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)      &kp LG(NUMBER_4)       &kp LG(NUMBER_5)
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp UP_ARROW    &kp LC(NUMBER_1)  &trans    &kp UP_ARROW    &kp LG(NUMBER_6)  &kp LG(NUMBER_7)  &kp LG(NUMBER_8)      &kp LG(NUMBER_9)       &kp LG(NUMBER_0)
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp DOWN_ARROW  &trans            &trans    &kp DOWN_ARROW  &kp LG(MINUS)     &kp LG(EQUAL)     &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(NON_US_BACKSLASH)
&trans          &trans                  &trans          &trans          &trans            &trans    &kp LEFT_ARROW  &kp RIGHT_ARROW                                                                  &kp LG(ENTER)
            >;

            sensor-bindings = <&inc_dec_kp LC(Z) LC(X)>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans     &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LC(W)  &kp LC(Q)                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
